{
  "name": "padh",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "padh", "database_id": "0d641a6e-3ad4-44db-81fb-95eda3a947bd" }],
  "triggers": { "crons": ["30 20 * * *"] },
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "vars": { "KEEP_AUDIO_RATE": "0.5", "MIN_GAP_DAYS": "7" }
}
