{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "react-jsx", "jsxImportSource": "preact", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "vite/client", "node"], "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["src"]
}
